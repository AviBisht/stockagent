# Required: Google Gemini API Key for ADK Agent Reasoning
GOOGLE_API_KEY=your_gemini_api_key_here

# Database URL for ADK session storage
DATABASE_URL=sqlite+aiosqlite:///my_agent_data.db

# API Server Host & Port
HOST=127.0.0.1
PORT=8000
